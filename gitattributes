# Line endings
# Store text files with LF line endings in the repository and check them out
# with LF on every machine (Windows and Linux/WSL alike). Git ignores
# line-ending differences when comparing text files.
* text=auto eol=lf

# Exception: csv files are checked out with CRLF line endings so they open and
# save cleanly in Microsoft Excel. They are still stored with LF in the
# repository.
*.csv text eol=crlf

# Binary files: never convert line endings or show text diffs
*.docx  binary
*.pptx  binary
*.xlsx  binary
*.pdf   binary
*.png   binary
*.rds   binary
*.RData binary
